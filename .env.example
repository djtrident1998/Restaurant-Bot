# --- AI models: an ordered chain; if one fails (rate limit / no credits / outage) the next is used ---
MODEL_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,google:gemini-3.5-flash,anthropic:claude-haiku-5-5
GROQ_API_KEY=your-key-here
GOOGLE_GENERATIVE_AI_API_KEY=your-key-here
ANTHROPIC_API_KEY=your-key-here

# --- Cost limits (all optional; defaults shown; see docs/COST_FRAMEWORK.md) ---
# LIMIT_PER_MINUTE=10          AI messages per visitor per minute
# LIMIT_PER_DAY=40             AI messages per visitor per day
# LIMIT_GLOBAL_PER_DAY=300     AI messages per server instance per day
# LIMIT_PAID_PER_DAY=60        calls to the paid model per day, shared across instances (0 = never use it)
# LIMIT_INPUT_CHARS=400        max characters per message
# LIMIT_HISTORY_MSG_CHARS=600  max characters kept per history message
# LIMIT_HISTORY_TOTAL_CHARS=4000
# LIMIT_BODY_BYTES=400000

# --- Accounts (sign up / sign in) ---
# Production: create a Vercel Blob store (Storage tab) and connect it to the project; Vercel adds this automatically.
# Without it, accounts live in memory and are lost on restart. Locally, accounts are stored in .data/users.json.
BLOB_READ_WRITE_TOKEN=
# Optional: secret used to sign login cookies. If unset, one is derived from BLOB_READ_WRITE_TOKEN.
SESSION_SECRET=

# --- Public address (optional) ---
# Used for share previews, sitemap and robots.txt. On Vercel the production domain is detected automatically;
# set this when you add a custom domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# --- Order cancellation (optional) ---
# CANCEL_WINDOW_MINUTES=10     minutes after placing an order during which it can be cancelled for a full refund (0 = off)

# --- Invoices (all optional; shown on the PDF only if set) ---
INVOICE_BUSINESS_NAME=
INVOICE_ADDRESS=
INVOICE_TAX_ID=
