# Ordered model chain: first is tried first; if it fails (rate limit / no credits / outage) the next is used.
# Providers without a key below are skipped; a recovered provider is used again automatically.
MODEL_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,google:gemini-3.5-flash,anthropic:claude-haiku-5-5
GROQ_API_KEY=your-key-here
GOOGLE_GENERATIVE_AI_API_KEY=your-key-here
ANTHROPIC_API_KEY=your-key-here
# Single-model alternative: MODEL_PROVIDER=anthropic and MODEL_ID=claude-haiku-5-5
